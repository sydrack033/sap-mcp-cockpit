{
  "name": "sap-mcp-cockpit",
  "version": "2.2.0",
  "_comment_description": "NAO passe de ~250 caracteres: o electron-builder joga este texto na descricao do atalho (CreateShortCut ... ${APP_DESCRIPTION}) e o campo de comentario do .lnk trunca em 255, corrompendo o IconLocation gravado logo depois — o atalho fica sem icone. O texto longo vive no README.",
  "description": "Liga seu assistente de IA (Claude Code / Codex) ao SAP via MCP.",
  "main": "main.js",
  "scripts": {
    "start": "node start.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "author": "Sydrack",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.sydrack.sapmcpcockpit",
    "productName": "SAP MCP Cockpit",
    "directories": {
      "output": "../../sap-mcp-cockpit-dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "start.js",
      "renderer/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "SAPMCPCockpit-Setup-${version}.exe",
      "shortcutName": "SAP MCP Cockpit",
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sydrack033",
        "repo": "sap-mcp-cockpit"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
